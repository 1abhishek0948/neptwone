{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "coderouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "CodeRouter",

      "options": {
        "baseURL": "https://www.coderouter.io/api/v1",
        "apiKey": "{env:CODEROUTER_API_KEY}",
        "headers": {
          "X-Routing-Strategy": "balanced"
        }
      },

      "models": {
        "auto": {
          "name": "CodeRouter Auto"
        },

        "claude-opus-4.8": {
          "name": "Claude Opus 4.8"
        },

        "gpt-5.5": {
          "name": "GPT-5.5"
        },

        "kimi-k3": {
          "name": "Kimi K3"
        },

        "glm-5.2": {
          "name": "GLM-5.2"
        },

        "claude-sonnet-4.6": {
          "name": "Claude Sonnet 4.6"
        }
      }
    }
  },

  "model": "coderouter/auto"
}